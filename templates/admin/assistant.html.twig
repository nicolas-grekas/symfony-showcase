{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Review assistant: {{ proposal.title }}{% endblock %}

{% block body %}
    <turbo-frame id="assistant">
        <h2>{{ ux_icon('lucide:bot') }} Review assistant <span class="badge">{{ ux_icon('lucide:eye') }} Read-only</span></h2>
        <p class="help-text">The assistant only reads. Accepting or rejecting a proposal is your decision, and asks for your password.</p>

        <h3>Similar talks and proposals</h3>
        {% if similar %}
            <table id="similar">
                <thead><tr><th>Title</th><th>Conference</th><th>Status</th><th>Similarity</th></tr></thead>
                <tbody>
                    {% for other in similar %}
                        <tr>
                            <td><a href="{{ path('proposal_show', {id: other.id}) }}" data-turbo-frame="_top">{{ other.title }}</a></td>
                            <td>{{ other.conference }}</td>
                            <td>{{ other.status|humanize }}</td>
                            <td>{{ ui.similarity(other.similarity) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% elseif proposal.embedding is null %}
            <p>The proposal is not embedded yet: a worker embeds the proposals after they are submitted.</p>
        {% else %}
            <p>There is no other talk or proposal.</p>
        {% endif %}

        <h3>Notes</h3>
        {% if writing %}
            {{ include('admin/_notes.html.twig', {source: path('admin_proposal_notes', {id: proposal.id, token: csrf_token('assistant')})}) }}
        {% elseif notes %}
            {{ include('admin/_notes.html.twig') }}
        {% endif %}
        <form method="post" action="{{ path('admin_proposal_review', {id: proposal.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('assistant') }}">
            <button type="submit">{{ ux_icon('lucide:sparkles') }} {{ notes ? 'Summarize again' : 'Summarize' }}</button>
        </form>
    </turbo-frame>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Back office{% endblock %}

{% block body %}
    <h1>Back office</h1>

    <h2>Search by meaning</h2>
    <p class="help-text">The closest talks and proposals of all conferences, by the embeddings of the review assistant.</p>
    <twig:SemanticSearch />

    <h2>Conferences</h2>

    <ul>
        {% for conference in conferences %}
            <li>
                <a href="{{ path('admin_proposals', {conference: conference.id}) }}">{{ conference.name }}</a>: proposals
                {% if is_granted('ROLE_ORGANIZER') %}
                    · <a href="{{ path('admin_sales', {id: conference.id}) }}">ticket sales</a>
                    · <a href="{{ path('admin_schedule', {id: conference.id}) }}">schedule</a>
                    · <a href="{{ path('admin_conference_edit', {id: conference.id}) }}">edit</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if is_granted('ROLE_ORGANIZER') %}
        <p><a class="button" href="{{ path('admin_conference_new') }}">New conference</a></p>
        <p><a href="{{ path('admin_failed_messages') }}">Failed messages</a></p>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
        <p><a href="{{ path('admin_users') }}">Users</a></p>
    {% endif %}
{% endblock %}

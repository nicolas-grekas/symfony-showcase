{% extends 'base.html.twig' %}

{% block title %}Back office{% endblock %}

{% block body %}
    <h1>Back office</h1>

    <ul>
        {% for conference in conferences %}
            <li>
                <a href="{{ path('admin_proposals', {conference: conference.id}) }}">{{ conference.name }}</a>: proposals
                {% if is_granted('ROLE_ORGANIZER') %}· <a href="{{ path('admin_sales', {id: conference.id}) }}">ticket sales</a>{% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if is_granted('ROLE_ORGANIZER') %}
        <p><a href="{{ path('admin_failed_messages') }}">Failed messages</a></p>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
        <p><a href="{{ path('admin_users') }}">Users</a></p>
    {% endif %}
{% endblock %}

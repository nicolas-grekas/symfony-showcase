{% macro transition_button(route, proposal, label) %}
    <form method="post" action="{{ path(route, {id: proposal.id}) }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('proposal-transition') }}">
        <button type="submit">{{ label }}</button>
    </form>
{% endmacro %}

{# A ticket is shown to whoever has this link, signed until the day after the conference #}
{% macro ticket_url(ticket) %}
    {{- url('ticket_show', {id: ticket.id})|sign_url(ticket.conference.endsOn|date_modify('+1 day')) -}}
{% endmacro %}

{# the cosine similarity of two embeddings, from 0 to 1 #}
{% macro similarity(value) %}
    <span class="similarity"><meter min="0" max="1" value="{{ value }}"></meter> {{ (value * 100)|round }}%</span>
{%- endmacro %}

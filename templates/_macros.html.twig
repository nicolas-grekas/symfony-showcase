{# The firewall only logs out on a POST request carrying a CSRF token #}
{% macro logout_button() %}
    <form method="post" action="{{ path('app_logout') }}" class="inline">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit">Log out</button>
    </form>
{% endmacro %}

{# The firewall switches the user on a POST request to the page to go to, carrying a CSRF token #}
{% macro impersonate_button(user, target_path) %}
    <form method="post" action="{{ target_path }}" class="inline">
        <input type="hidden" name="_switch_user" value="{{ user.userIdentifier }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('switch_user') }}">
        <button type="submit">Impersonate</button>
    </form>
{% endmacro %}

{% macro exit_impersonation_button(target_path) %}
    <form method="post" action="{{ target_path }}" class="inline">
        <input type="hidden" name="_switch_user" value="_exit">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('switch_user') }}">
        <button type="submit">Exit impersonation</button>
    </form>
{% endmacro %}

{% macro transition_button(route, proposal, label) %}
    <form method="post" action="{{ path(route, {id: proposal.id}) }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('proposal-transition') }}">
        <button type="submit">{{ label }}</button>
    </form>
{% endmacro %}

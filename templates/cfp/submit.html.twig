{% extends 'base.html.twig' %}

{% form_theme form _self %}

{% block title %}Call for papers: {{ conference.name }}{% endblock %}

{% block body %}
    <h1>Call for papers: {{ conference.name }}</h1>

    {% set current = form.vars.cursor.currentStep %}
    <ol class="steps">
        <li class="{{ current == 'speaker' ? 'current' }}">Speaker</li>
        <li class="{{ current in ['talk', 'materials'] ? 'current' }}">
            Proposal
            <ol>
                <li class="{{ current == 'talk' ? 'current' }}">Talk</li>
                <li class="{{ current == 'materials' ? 'current' }}">Materials</li>
            </ol>
        </li>
        <li class="{{ current == 'review' ? 'current' }}">Review</li>
    </ol>

    {{ form_start(form) }}
        {% if form.materials is defined %}
            <div data-controller="polymorphic-collection" data-polymorphic-collection-index-value="{{ form.materials|length }}">
                {{ form_row(form.materials) }}
                <p>
                    <button type="button" data-action="polymorphic-collection#add" data-polymorphic-collection-type-param="slides">Add slides</button>
                    <button type="button" data-action="polymorphic-collection#add" data-polymorphic-collection-type-param="video">Add a video</button>
                </p>
            </div>
        {% endif %}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{# the polymorphic-collection controller adds the entries from these prototypes #}
{% block material_collection_widget -%}
    {%- for kind, prototype in prototypes -%}
        {%- set attr = attr|merge({('data-prototype-' ~ kind): form_row(prototype)}) -%}
    {%- endfor -%}
    {{- block('form_widget') -}}
{%- endblock %}

{# each level is described below its radio button #}
{% block _proposal_flow_talk_level_widget -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form -%}
            {{- form_widget(child, {attr: child.vars.attr|merge({'aria-describedby': child.vars.id ~ '_help'})}) -}}
            {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            <div id="{{ child.vars.id }}_help" class="help-text">{{ choices[child.vars.name].data.help|trans }}</div>
        {%- endfor -%}
    </div>
{%- endblock %}

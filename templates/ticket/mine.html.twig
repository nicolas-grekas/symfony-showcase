{% extends 'base.html.twig' %}
{% from '_macros.html.twig' import ticket_url %}

{% block title %}My tickets{% endblock %}

{% block body %}
    <h1>My tickets</h1>

    <ul>
        {% for ticket in tickets %}
            <li><a href="{{ ticket_url(ticket) }}">{{ ticket.conference.name }}</a>, {{ ticket.conference.startsOn|date('F j, Y') }}</li>
        {% else %}
            <li>No tickets yet.</li>
        {% endfor %}
    </ul>
{% endblock %}

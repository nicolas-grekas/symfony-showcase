<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Conferences{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎤</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <nav>
                <a href="{{ path('home') }}"><strong>Conferences</strong></a>
                <span class="spacer"></span>
                {% if is_granted('ROLE_REVIEWER') %}
                    <a href="{{ path('admin_dashboard') }}">Back office</a>
                {% endif %}
                {{ impersonation_exit_button('Exit impersonation', path('admin_users'), formAttr: {class: 'inline'}) }}
                {% if app.user %}
                    <span>{{ app.user.name ?? app.user.userIdentifier }}</span>
                    <a href="{{ path('speaker_proposals') }}">My proposals</a>
                    <a href="{{ path('me_tickets') }}">My tickets</a>
                    {{ logout_button(formAttr: {class: 'inline'}) }}
                {% else %}
                    <a href="{{ path('app_login') }}">Log in</a>
                {% endif %}
            </nav>
        </header>
        <main>
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <p class="flash flash-{{ type }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>

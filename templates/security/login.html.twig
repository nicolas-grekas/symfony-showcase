{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <h1>{% if re_authentication %}{{ ux_icon('lucide:lock') }} Confirm your password{% else %}Log in{% endif %}</h1>

    {% if re_authentication %}
        <p>This action needs a recent authentication, please type your password again.</p>
    {% endif %}

    {% if error %}
        <p class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post">
        <div>
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required {{ re_authentication ? 'readonly' : 'autofocus' }}>
        </div>
        <div>
            <label for="password">Password</label>
            <input type="password" name="_password" id="password" autocomplete="current-password" required {{ re_authentication ? 'autofocus' }}>
        </div>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit">{{ re_authentication ? 'Confirm' : 'Log in' }}</button>
    </form>

    {% if not re_authentication %}
        <p>Speakers log in with their <a href="{{ path('_oidc_login_start_main') }}">conference account</a>.</p>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ proposal.title }}{% endblock %}

{% block body %}
    <h1>{{ proposal.title }}</h1>
    <p>
        {{ proposal.speakers|map(s => s.name)|join(', ') }} · {{ proposal.format|trans }} · {{ proposal.level|trans }}
        · <strong>{{ proposal.status.value|humanize }}</strong>
    </p>
    <p><a href="{{ path('conference_show', {slug: proposal.conference.slug}) }}">{{ proposal.conference.name }}</a></p>

    <p class="actions">
        {% if workflow_can(proposal, 'start_review') and is_granted('PROPOSAL_REVIEW', proposal) %}
            {{ ui.transition_button('proposal_start_review', proposal, 'Start the review') }}
        {% endif %}
        {% if workflow_can(proposal, 'accept') and is_granted('PROPOSAL_REVIEW', proposal) %}
            <a class="button" href="{{ path('proposal_decide', {id: proposal.id}) }}" title="Asks for your password">{{ ux_icon('lucide:lock') }} Accept or reject</a>
        {% endif %}
        {% if workflow_can(proposal, 'withdraw') and is_granted('PROPOSAL_WITHDRAW', proposal) %}
            {{ ui.transition_button('proposal_withdraw', proposal, 'Withdraw') }}
        {% endif %}
    </p>

    <div class="abstract">{{ proposal.abstract|nl2br }}</div>

    {% if proposal.materials is not empty %}
        <h2>Material</h2>
        <ul>
            {% for material in proposal.materials %}
                <li><a href="{{ material.url }}" rel="nofollow noopener">{{ material.url }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if is_granted('PROPOSAL_REVIEW', proposal) %}
        <turbo-frame id="assistant" src="{{ path('admin_proposal_assistant', {id: proposal.id}) }}" loading="lazy"></turbo-frame>
    {% endif %}
{% endblock %}
